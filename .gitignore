# Dependencies — reinstalled, never committed.
node_modules/

# Local PGLite dev database files.
.pglite/

# Raw source GIS drops — large, offline-only inputs to scripts/prepare-*.mjs.
Data Storage/

# Prepared runtime data (regenerated from Data Storage by scripts/prepare-*.mjs) —
# large (~500MB+), shared between the production and experiment folders via a
# directory junction rather than duplicated or tracked in git.
private-data/

# Whole Vercel folder — build output, AND project.json, which links this
# folder to a specific Vercel project. Machine/checkout-local, must never be
# shared between the production and experiment folders (or committed at
# all) — that's exactly what caused an early experiment deploy to land in
# the production "kanopi" project instead of a separate one.
.vercel/
dist/

# Vite/TanStack Router caches.
.tanstack/

# Local scratch/output folders, not part of the app.
attachments/
artifacts/
screenshots/

# OS/editor cruft.
.DS_Store
Thumbs.db

.env*
.vercel
